          },
          "refId": "A",
          "expr": "round(sum by (service) (increase(zlrd_service_crashes_total{instance=~\"$instance\"}[$__interval]))) > 0",
          "legendFormat": "{{service}} crash"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "round(sum by (service) (increase(zlrd_service_restarts_total{instance=~\"$instance\"}[$__interval]))) > 0",
          "legendFormat": "{{service}} restart"
